# ── App ─────────────────────────────────────────────
# The public address. On Vercel it may be left unset: the production domain is then taken from Vercel itself.
APP_URL=http://localhost:3000
# At least 32 random characters. Encrypts national IDs and signs email codes. Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later makes stored national IDs unreadable, so keep it safe and backed up.
APP_SECRET=

# ── Database ────────────────────────────────────────
# Empty in development: an embedded PostgreSQL is created in ./.data/pg. Required in production.
# PostgreSQL 14 or newer. On serverless hosts (Vercel) use the provider's POOLED address here.
# POSTGRES_URL is read too, for hosts that name it that way.
DATABASE_URL=
# Optional direct (unpooled) address. Migrations prefer it when present. Neon's Vercel integration sets it.
DATABASE_URL_UNPOOLED=

# ── Email (verification codes, password reset, email change) ──
# Development: leave EMAIL_PROVIDER empty and the message, with its code, is printed in the terminal.
# Production must use a real provider; the server refuses to start otherwise.
#   resend | sendgrid | postmark  → EMAIL_API_KEY
#   ses                           → AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM="EduHub <no-reply@your-domain.example>"
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Google sign-in (optional; the button appears only when both are set) ──
# Authorised redirect URI to register with Google:  <APP_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Files ───────────────────────────────────────────
# local       = a folder on disk (development, or a host with a persistent disk)
# vercel-blob = a PRIVATE Vercel Blob store; chosen automatically when BLOB_READ_WRITE_TOKEN is present.
#               Vercel adds BLOB_READ_WRITE_TOKEN itself when you create the store and connect it to the project.
# Vercel has no writable disk: there, without a Blob store, uploads answer "storage not configured".
STORAGE_DRIVER=
STORAGE_DIR=./.data/files
BLOB_READ_WRITE_TOKEN=
MAX_UPLOAD_MB=100
DEFAULT_QUOTA_GB=2

# ── AI assistant ────────────────────────────────────
# mock = a labelled sample reply, no key needed. anthropic = Claude through the Anthropic Messages API.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_MESSAGE_LIMIT=100

# ── Tuning ──────────────────────────────────────────
# Accepted shape of the national ID (a regular expression). Default: 6 to 20 digits.
NATIONAL_ID_PATTERN=
DEFAULT_UNITS_PER_SEMESTER=12
# The session token is replaced this often; the replaced one stays valid this long for requests in flight.
SESSION_ROTATE_SECONDS=86400
SESSION_ROTATION_GRACE_SECONDS=60

# ── Landing page ────────────────────────────────────
# Optional short looping mp4 for the hero. Without it the animated scene shows.
NEXT_PUBLIC_HERO_VIDEO=

# Number of reverse proxies in front of the app (1 on Render and most hosts). Decides which
# X-Forwarded-For entry is treated as the client's address for rate limiting.
TRUSTED_PROXY_HOPS=1
